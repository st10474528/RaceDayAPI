@model List<RaceDayMVC.Models.ResultDto>
@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-4">
    <h2 class="mb-4">My Race History</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">You don't have any recorded race results yet. Keep training!</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Enrolment ID</th>
                            <th>Finish Time</th>
                            <th>Finishing Position</th>
                            <th>Recorded On</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.EnrolmentID</td>
                                <td><strong>@item.FinishTime</strong></td>
                                <td>@item.FinishingPosition</td>
                                <td>@item.RecordedAt.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>