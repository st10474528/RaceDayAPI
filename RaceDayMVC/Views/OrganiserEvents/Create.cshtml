@{
    ViewData["Title"] = "Create Event";
}
<div class="container mt-4">
    <h2>Create New Event</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <div class="card shadow-sm mt-3">
        <div class="card-body">
            <form method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label>Event Name</label>
                    <input name="name" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label>Description</label>
                    <textarea name="description" class="form-control"></textarea>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label>Date</label>
                        <input type="date" name="eventDate" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label>Location</label>
                        <input name="location" class="form-control" required />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label>Distance (km)</label>
                        <input type="number" step="0.1" name="distance" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label>Event Type</label>
                        <select name="eventTypeId" class="form-select">
                            <option value="1">Run</option>
                            <option value="2">Walk</option>
                            <option value="3">Cycle</option>
                        </select>
                    </div>
                </div>
                <div class="mb-3">
                    <label>Banner Image</label>
                    <input type="file" name="banner" class="form-control" accept="image/*" />
                </div>
                <button class="btn btn-primary">Create Event</button>
            </form>
        </div>
    </div>
</div>