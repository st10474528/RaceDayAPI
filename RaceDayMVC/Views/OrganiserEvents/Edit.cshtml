@model RaceDayMVC.Models.EventDto
@{
    ViewData["Title"] = "Edit Event";
}

<div class="container mt-4">
    <h2>Edit Event: @Model.Name</h2>
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <div class="card shadow-sm mt-3">
        <div class="card-body">
            <form method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label>Event Name</label>
                    <input name="name" value="@Model.Name" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label>Description</label>
                    <textarea name="description" class="form-control">@Model.Description</textarea>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label>Date</label>
                        <!-- Format the date as yyyy-MM-dd so the HTML5 date picker reads it correctly -->
                        <input type="date" name="eventDate" value="@Model.EventDate.ToString("yyyy-MM-dd")" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label>Location</label>
                        <input name="location" value="@Model.Location" class="form-control" required />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label>Distance (km)</label>
                        <input type="number" step="0.1" name="distance" value="@Model.Distance" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label>Event Type</label>
                        <select name="eventTypeId" class="form-select">
                            <option value="1" selected="@(Model.EventTypeID == 1)">Run</option>
                            <option value="2" selected="@(Model.EventTypeID == 2)">Walk</option>
                            <option value="3" selected="@(Model.EventTypeID == 3)">Cycle</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label>Update Banner Image (Optional)</label>
                    <input type="file" name="banner" class="form-control" accept="image/*" />
                    <small class="text-muted">Leave empty to keep the current banner.</small>
                </div>

                <button class="btn btn-warning">Save Changes</button>
                <a asp-action="Manage" asp-route-id="@Model.EventID" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>