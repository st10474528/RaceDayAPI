@model RaceDayMVC.Models.EventDto
@{
    ViewData["Title"] = "Manage " + Model.Name;
    var categories = ViewBag.Categories as List<RaceDayMVC.Models.CategoryDto> ?? new List<RaceDayMVC.Models.CategoryDto>();
    var enrolments = ViewBag.Enrolments as List<RaceDayMVC.Models.EnrolmentDto> ?? new List<RaceDayMVC.Models.EnrolmentDto>();
    int eventId = ViewBag.EventId;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage: @Model.Name</h2>
        <a asp-action="Index" asp-controller="OrganiserDashboard" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row">
        <!-- Left Column: Categories -->
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Categories</h5>
                </div>
                <div class="card-body">
                    @if (categories.Any())
                    {
                        <ul class="list-group mb-3">
                            @foreach (var cat in categories)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <strong>@cat.CategoryName</strong>
                                    <span class="badge bg-secondary">@(cat.MinimumAge ?? 0) - @(cat.MaximumAge?.ToString() ?? "∞") yrs</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">No categories added yet.</p>
                    }

                    <hr />
                    <h6>Add New Category</h6>
                    <form method="post" asp-action="AddCategory">
                        <input type="hidden" name="eventId" value="@eventId" />
                        <div class="mb-2">
                            <input name="categoryName" class="form-control" placeholder="Name (e.g., Senior)" required />
                        </div>
                        <div class="row mb-2">
                            <div class="col-6">
                                <input name="minimumAge" type="number" class="form-control" placeholder="Min Age" />
                            </div>
                            <div class="col-6">
                                <input name="maximumAge" type="number" class="form-control" placeholder="Max Age" />
                            </div>
                        </div>
                        <button class="btn btn-sm btn-primary w-100">Add Category</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right Column: Enrolments & Results -->
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Participants & Results</h5>
                </div>
                <div class="card-body">
                    @if (enrolments.Any())
                    {
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Enrolment ID</th>
                                    <th>Participant ID</th>
                                    <th>Category</th>
                                    <th>Status</th>
                                    <th>Capture Result</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var enr in enrolments)
                                {
                                    <tr>
                                        <td>@enr.EnrolmentID</td>
                                        <td>@enr.ParticipantID</td>
                                        <td>@categories.FirstOrDefault(c => c.CategoryID == enr.CategoryID)?.CategoryName</td>
                                        <td><span class="badge bg-success">@enr.Status</span></td>
                                        <td>
                                            <form method="post" asp-action="CaptureResult" class="d-flex gap-2">
                                                <input type="hidden" name="enrolmentId" value="@enr.EnrolmentID" />
                                                <input type="hidden" name="eventId" value="@eventId" />
                                                <input name="finishTime" class="form-control form-control-sm" placeholder="00:45:00" required style="width: 100px;" />
                                                <input name="finishingPosition" type="number" class="form-control form-control-sm" placeholder="Pos" required style="width: 70px;" />
                                                <button class="btn btn-sm btn-outline-success">Save</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No participants have enrolled yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>