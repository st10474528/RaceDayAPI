@model List<RaceDayMVC.Models.EventDto>
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Organiser Dashboard</h2>
        <a asp-action="Create" asp-controller="OrganiserEvents" class="btn btn-success fw-bold">+ Create New Event</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">You haven't created any events yet.</div>
    }
    else
    {
        <div class="row">
            @foreach (var ev in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h5 class="card-title">@ev.Name</h5>
                            <p class="card-text text-muted mb-1">
                                <strong>Date:</strong> @ev.EventDate.ToString("dd MMM yyyy")<br />
                                <strong>Location:</strong> @ev.Location
                            </p>
                        </div>
                        <div class="card-footer bg-white border-top-0 d-flex gap-2">
                            <!-- Manage Button -->
                            <a asp-action="Manage" asp-controller="OrganiserEvents" asp-route-id="@ev.EventID" class="btn btn-primary flex-grow-1">Manage</a>

                            <!-- Edit Button -->
                            <a asp-action="Edit" asp-controller="OrganiserEvents" asp-route-id="@ev.EventID" class="btn btn-warning">Edit</a>

                            <!-- Delete Button (using a POST form) -->
                            <form asp-action="Delete" asp-controller="OrganiserEvents" asp-route-id="@ev.EventID" method="post" onsubmit="return confirm('Delete @ev.Name?');">
                                <button type="submit" class="btn btn-danger">🗑️</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>